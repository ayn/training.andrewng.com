{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "training-calendar-archive",
  "main": "src/index.js",
  "compatibility_date": "2026-11-06",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "training.example.com",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "vars": {
    "CALENDAR_NAME": "Training archive"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "training-calendar-archive",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": false
  }
}
